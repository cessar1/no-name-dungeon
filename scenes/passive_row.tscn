[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/passive_row.gd" id="1"]

[node name="PassiveRow" type="HBoxContainer"]
theme_override_constants/separation = 8
script = ExtResource("1")

[node name="Info" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 0

[node name="NameLabel" type="Label" parent="Info"]
unique_name_in_owner = true
layout_mode = 2
text = "Nombre de la pasiva (1 punto)"

[node name="DescriptionLabel" type="Label" parent="Info"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Descripción breve de la pasiva."

[node name="LearnButton" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "Aprender"
